{
  "name": "lunch-special",
  "version": "0.1.0",
  "description": "Lunch Special — a daily dish-guessing game set in the golden age of diners",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "play": "vite --open /play",
    "ramen": "vite --open /play?special=ramen",
    "admin": "vite --open /admin",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "check": "tsc -b",
    "cf-typegen": "wrangler types",
    "assets:discord": "node discord-assets/build.mjs",
    "discord:register": "node scripts/discord-register-command.mjs",
    "assets:icons": "node scripts/build-icons.mjs",
    "assets:keyart": "node scripts/build-keyart.mjs",
    "assets:press": "node scripts/build-press-kit.mjs",
    "db:migrate": "wrangler d1 migrations apply lunch-special-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lunch-special-db --remote",
    "db:seed": "wrangler d1 execute lunch-special-db --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute lunch-special-db --remote --file=seed/seed.sql",
    "db:export": "node scripts/db-export.mjs --local",
    "db:export:remote": "node scripts/db-export.mjs",
    "db:export:catalog": "node scripts/db-export.mjs --catalog"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "hono": "^4.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "better-sqlite3": "^13.0.3",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.112.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}

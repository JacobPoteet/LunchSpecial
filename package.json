{
  "name": "lunch-special",
  "version": "0.1.0",
  "description": "Lunch Special — a daily dish-guessing game set in the golden age of diners",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "play": "vite --open /play",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "check": "tsc -b",
    "cf-typegen": "wrangler types",
    "assets:discord": "node discord-assets/build.mjs",
    "db:migrate": "wrangler d1 migrations apply lunch-special-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lunch-special-db --remote",
    "db:seed": "wrangler d1 execute lunch-special-db --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute lunch-special-db --remote --file=seed/seed.sql"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "hono": "^4.12.30",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "better-sqlite3": "^12.11.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260714.1": true
  }
}

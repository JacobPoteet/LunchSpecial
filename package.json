{
  "name": "lunch-special",
  "version": "0.1.0",
  "description": "Lunch Special — a daily dish-guessing game set in the golden age of diners",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "play": "vite --open /play",
    "ramen": "vite --open /play?special=ramen",
    "lastcall": "vite --open \"/?handoff=1&nightcap=random\"",
    "negroni": "vite --open \"/?bar=1&handoff=1&nightcap=negroni\"",
    "admin": "vite --open /admin",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "a11y": "node scripts/a11y-scan.mjs",
    "check": "tsc -b",
    "lint": "oxlint",
    "cf-typegen": "wrangler types",
    "assets": "node scripts/build-assets.mjs",
    "discord:register": "node scripts/discord-register-command.mjs",
    "db:migrate": "wrangler d1 migrations apply lunch-special-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lunch-special-db --remote",
    "db:seed": "wrangler d1 execute lunch-special-db --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute lunch-special-db --remote --file=seed/seed.sql",
    "db:export": "node scripts/db-export.mjs --local",
    "db:export:remote": "node scripts/db-export.mjs",
    "db:export:catalog": "node scripts/db-export.mjs --catalog"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.57.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "oxlint": "^1.85.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.112.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": false,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  }
}

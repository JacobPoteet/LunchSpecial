{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunch-special",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunch-special-db",
      "database_id": "f331205d-c816-48c9-b099-0fb15b7605ba",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
  // Secrets (set via `wrangler secret put`, never committed):
  //   ADMIN_PASSWORD        — password for the /admin panel
  //   SESSION_SECRET        — random string used to sign admin session cookies
  //   DISCORD_CLIENT_ID     — Discord app id (public, but it travels with the
  //                           secret below so the pair stays together)
  //   DISCORD_CLIENT_SECRET — Discord app secret, for the Rich Presence OAuth
  //                           token exchange (/api/discord/token). Optional:
  //                           without it the game runs, minus presence.
  //   DISCORD_PUBLIC_KEY    — Discord app's Ed25519 public key, used to verify
  //                           that interactions really came from Discord
  //                           (/api/discord/interactions). Optional: without it
  //                           the endpoint answers 503 and the Activity's live
  //                           progress message simply doesn't post.
  // NOT a secret here: the bot token. It's used once, by
  // scripts/discord-register-command.mjs, and nothing in the running app has one.
}

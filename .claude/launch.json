{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lunch-special",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "breakdown-page",
      "runtimeExecutable": "python",
      "runtimeArgs": [

# Copy to .dev.vars for local development (never committed).
# In production, set these with `wrangler secret put ADMIN_PASSWORD` etc.
ADMIN_PASSWORD=choose-a-password
SESSION_SECRET=any-long-random-string

# Deprecated / no longer required: random play ("cook's choice") is now a
# spoiler-free production feature, so the Worker doesn't gate it. Kept only so
# the dev /play + ?freeplay convenience routes read as intentional.
DEV_FREEPLAY=true

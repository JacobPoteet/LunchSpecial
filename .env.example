# Vite build-time public env vars. Copy the ones you need into a local
# `.env.local` (gitignored) for `npm run dev`, and set them in CI for builds.
#
# NOTE: this file is for CLIENT (VITE_*) vars only. Worker secrets
# (ADMIN_PASSWORD, SESSION_SECRET, and the DISCORD_CLIENT_ID /
# DISCORD_CLIENT_SECRET pair the Rich Presence token exchange needs) live in
# `.dev.vars` instead.

# Discord application Client ID (from the Discord Developer Portal).
# Public — it ships in the client bundle, so it is NOT a secret. Required only
# to run inside Discord as an Activity; the open-web game ignores it.
VITE_DISCORD_CLIENT_ID=
